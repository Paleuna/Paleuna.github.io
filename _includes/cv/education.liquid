{% comment %}
  Unified education entry renderer for both RenderCV and JSONResume formats
  Handles both:
  - RenderCV: institution, area, studyType (or degree), start_date, end_date, location, url, logo, courses, highlights
  - JSONResume: institution, area, studyType, startDate, endDate, location, url, logo, courses, highlights
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 col-sm-2 col-md-2 text-center">
          {% if entry.logo %}
            <img src="{{ entry.logo | relative_url }}" alt="{{ entry.institution }} logo" class="company-logo" style="max-width: 80px; max-height: 80px;">
          {% endif %}
        </div>
        <div class="col-xs-10 col-sm-10 col-md-10 mt-2 mt-md-0">
          {% if entry.institution %}
            <h6 class="title font-weight-bold ml-1 ml-md-4" style="color: var(--global-theme-color)">
              {% if entry.url %}<a href="{{ entry.url }}" target="_blank" rel="noopener">{{ entry.institution }}</a>{% else %}{{ entry.institution }}{% endif %}
            </h6>
          {% endif %}

          {% capture study_type %}
            {% if entry.studyType %}{{ entry.studyType }}{% elsif entry.degree %}{{ entry.degree }}{% endif %}
          {% endcapture %}
          {% if study_type != '' %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ study_type }}</h6>
          {% endif %}

          {% if entry.area %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ entry.area }}</h6>
          {% endif %}

          {% capture location %}
            {% if entry.location %}{{ entry.location }}{% endif %}
          {% endcapture %}
          {% if location != '' %}
            <p class="ml-1 ml-md-4 mb-1">
              <strong>Location</strong>: {{ location }}
            </p>
          {% endif %}

          {% comment %} Build a human-readable duration line, e.g. "Aug. 2025 - Feb. 2026" or just "2025" {% endcomment %}
          {% capture start_raw %}
            {% if entry.start_date %}{{ entry.start_date }}{% elsif entry.startDate %}{{ entry.startDate }}{% endif %}
          {% endcapture %}
          {% assign start_raw = start_raw | strip %}
          {% capture end_raw %}
            {% if entry.end_date %}{{ entry.end_date }}{% elsif entry.endDate %}{{ entry.endDate }}{% endif %}
          {% endcapture %}
          {% assign end_raw = end_raw | strip %}

          {% assign start_display = '' %}
          {% if start_raw != '' %}
            {% assign start_len = start_raw | size %}
            {% if start_len == 4 %}
              {% assign start_display = start_raw %}
            {% else %}
              {% assign start_full = start_raw | append: '-01' %}
              {% assign start_display = start_full | date: "%b. %Y" %}
            {% endif %}
          {% endif %}

          {% assign end_raw_lower = end_raw | downcase %}
          {% assign end_display = 'Present' %}
          {% if end_raw != '' and end_raw_lower != 'present' %}
            {% assign end_len = end_raw | size %}
            {% if end_len == 4 %}
              {% assign end_display = end_raw %}
            {% else %}
              {% assign end_full = end_raw | append: '-01' %}
              {% assign end_display = end_full | date: "%b. %Y" %}
            {% endif %}
          {% endif %}

          {% if start_display != '' %}
            {% if start_display == end_display %}
              {% assign duration = start_display %}
            {% else %}
              {% assign duration = start_display | append: ' - ' | append: end_display %}
            {% endif %}
          {% else %}
            {% assign duration = '' %}
          {% endif %}

          {% if duration != '' %}
            <p class="ml-1 ml-md-4 mb-1">
              <strong>Duration</strong>: {{ duration }}
            </p>
          {% endif %}

          {% if entry.courses or entry.highlights %}
            <ul class="items">
              {% for item in entry.courses %}
                <li>
                  <span class="item">{{ item }}</span>
                </li>
              {% endfor %}
              {% for item in entry.highlights %}
                <li>
                  <span class="item">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
