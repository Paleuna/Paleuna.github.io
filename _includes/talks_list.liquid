{% assign talks = site.data.talks %}
{% if talks and talks.size > 0 %}
  {% assign talks = talks | sort: 'date' | reverse %}
  {% assign previous_year = '' %}
  {% for talk in talks %}
    {% assign talk_year = talk.date | date: '%Y' %}
    {% if talk_year != previous_year %}
      <h2 class="mt-4 mb-3">{{ talk_year }}</h2>
      {% assign previous_year = talk_year %}
    {% endif %}
    <div class="mb-4 pb-3 border-bottom">
      <h3 class="mb-1">{{ talk.title }}</h3>
      <p class="post-meta mb-2">
        {{ talk.date | date: '%B %d, %Y' }}
        {% if talk.event %}&nbsp; &middot; &nbsp; {{ talk.event }}{% endif %}
        {% if talk.type %}&nbsp; &middot; &nbsp; {{ talk.type }}{% endif %}
        {% if talk.location %}&nbsp; &middot; &nbsp; {{ talk.location }}{% endif %}
      </p>
      {% if talk.description %}<p class="mb-2">{{ talk.description }}</p>{% endif %}
      {% if talk.slides %}
        {% assign slides_url = talk.slides %}
        {% unless talk.slides contains '://' %}
          {% assign slides_url = talk.slides | relative_url %}
        {% endunless %}
        <a class="btn btn-sm z-depth-0" href="{{ slides_url }}" target="_blank" rel="noopener noreferrer">Slides</a>
      {% endif %}
      {% if talk.video %}
        <a class="btn btn-sm z-depth-0" href="{{ talk.video }}" target="_blank" rel="noopener noreferrer">Video</a>
      {% endif %}
      {% if talk.event_url %}
        <a class="btn btn-sm z-depth-0" href="{{ talk.event_url }}" target="_blank" rel="noopener noreferrer">Event</a>
      {% endif %}
    </div>
  {% endfor %}
{% else %}
  <p>Talks and presentations will appear here as they become available.</p>
{% endif %}
