{% assign talks = site.data.talks %}
{% if talks and talks.size > 0 %}
  {% assign talks = talks | sort: 'date' | reverse %}
  {% assign previous_year = '' %}
  {% for talk in talks %}
    {% assign talk_year = talk.date | date: '%Y' %}
    {% if talk_year != previous_year %}
      {% unless forloop.first %}</section>{% endunless %}
      <section class="talks-year-group" aria-label="Talks in {{ talk_year }}">
        <h2 class="talks-year-heading"><span>{{ talk_year }}</span></h2>
      {% assign previous_year = talk_year %}
    {% endif %}
    <article class="talks-entry">
      <div class="talks-entry__date">
        <time datetime="{{ talk.date | date: '%Y-%m-%d' }}" aria-label="{{ talk.date | date: '%B %-d, %Y' }}">
          <span class="talks-entry__month">{{ talk.date | date: '%b' }}</span>
          <span class="talks-entry__day">{{ talk.date | date: '%-d' }}</span>
        </time>
      </div>
      <div class="talks-entry__content">
        {% if talk.type %}
          <div class="talks-entry__eyebrow">{{ talk.type | escape }}</div>
        {% endif %}
        <h3 class="talks-entry__title">{{ talk.title | escape }}</h3>
        {% if talk.event or talk.location %}
          <div class="talks-entry__venue">
            {% if talk.event %}<span class="talks-entry__event">{{ talk.event | escape }}</span>{% endif %}
            {% if talk.event and talk.location %}<span class="talks-entry__separator" aria-hidden="true">&middot;</span>{% endif %}
            {% if talk.location %}<span>{{ talk.location | escape }}</span>{% endif %}
          </div>
        {% endif %}

        {% if talk.description %}
          {% assign abstract_length = talk.description | number_of_words %}
          {% if abstract_length > 44 %}
            <details class="talks-entry__abstract">
              <summary>
                <span class="talks-entry__teaser">{{ talk.description | strip_html | truncatewords: 34 | escape }}</span>
                <span class="talks-entry__abstract-action">
                  <span class="talks-entry__show">Read abstract</span>
                  <span class="talks-entry__hide">Hide abstract</span>
                  <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                </span>
              </summary>
              <div class="talks-entry__abstract-full">{{ talk.description | markdownify }}</div>
            </details>
          {% else %}
            <p class="talks-entry__teaser">{{ talk.description | escape }}</p>
          {% endif %}
        {% endif %}

        {% if talk.slides or talk.video or talk.event_url %}
          <div class="talks-entry__links" aria-label="Resources for this talk">
            {% if talk.slides %}
              {% assign slides_url = talk.slides %}
              {% unless talk.slides contains '://' %}
                {% assign slides_url = talk.slides | relative_url %}
              {% endunless %}
              <a href="{{ slides_url | escape }}" target="_blank" rel="noopener noreferrer"><i class="fa-regular fa-file-pdf" aria-hidden="true"></i> Slides <span aria-hidden="true">↗</span></a>
            {% endif %}
            {% if talk.video %}
              {% assign video_url = talk.video %}
              {% unless talk.video contains '://' %}
                {% assign video_url = talk.video | relative_url %}
              {% endunless %}
              <a href="{{ video_url | escape }}" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-play" aria-hidden="true"></i> Video <span aria-hidden="true">↗</span></a>
            {% endif %}
            {% if talk.event_url %}
              {% assign event_url = talk.event_url %}
              {% unless talk.event_url contains '://' %}
                {% assign event_url = talk.event_url | relative_url %}
              {% endunless %}
              <a href="{{ event_url | escape }}" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i> Event <span aria-hidden="true">↗</span></a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </article>
  {% endfor %}
  </section>
{% else %}
  <p>Talks and presentations will appear here as they become available.</p>
{% endif %}
