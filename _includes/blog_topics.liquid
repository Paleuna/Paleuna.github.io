<section class="mb-5" aria-labelledby="notes-topics-heading">
  <h2 id="notes-topics-heading" class="mb-2">Explore by topic</h2>
  <p class="mb-3">Papers as research projects, and notes on the questions behind them.</p>
  <div class="row">
    {% for topic in site.data.blog_topics %}
      {% assign topic_posts = site.categories[topic.slug] %}
      {% assign topic_count = topic_posts | size %}
      <div class="col-sm-6 mb-3">
        {% if topic_count > 0 %}
          {% capture topic_url %}/blog/category/{{ topic.slug }}/{% endcapture %}
          <a href="{{ topic_url | relative_url }}" class="card hoverable h-100 text-decoration-none" aria-label="{{ topic.title | escape }}: {{ topic_count }} notes">
            <div class="card-body">
              <h3 class="card-title">{{ topic.title }}</h3>
              <p class="card-text">{{ topic.description }}</p>
              <small class="text-muted">{{ topic_count }} {% if topic_count == 1 %}note{% else %}notes{% endif %} &rarr;</small>
            </div>
          </a>
        {% else %}
          <div class="card h-100">
            <div class="card-body">
              <h3 class="card-title">{{ topic.title }}</h3>
              <p class="card-text">{{ topic.description }}</p>
              <small class="text-muted">Coming soon</small>
            </div>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>
